GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
JUDGE_GROQ=
PORTKEY_API_KEY=
PORTKEY_CONFIG_SLUG=
# Set to true only when the saved Portkey config targets live models (openai/gpt-oss-120b)
USE_PORTKEY=false
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=
#
# --- Embeddings ---
# Which embedding backend to use: aicredits | local
#   aicredits -> OpenAI-compatible gateway (api.aicredits.in). Its /v1/embeddings
#                route serves ONLY OpenAI embedding models (Gemini ids -> 400)
#   local     -> offline sentence-transformers (no API key, 768-dim)
EMBEDDING_PROVIDER=aicredits
AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://api.aicredits.in/v1
AICREDITS_EMBEDDING_MODEL=text-embedding-3-large
# Optional: MRL truncation (only if the provider honours `dimensions`)
# EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=50
EMBEDDING_ALLOW_LOCAL_FALLBACK=true

LOGFIRE_TOKEN=
BACKEND_URL=http://localhost:8000
